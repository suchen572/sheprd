cloud-setup-summary-nothing = 无需运行任何内容。
cloud-setup-summary-runs = { $lines ->
       *[other] 运行你自己的 { $lines } 行脚本。
    }
cloud-setup-summary-installs = 安装 { $agents }。
cloud-setup-summary-installs-runs = { $lines ->
       *[other] 安装 { $agents }，然后运行你自己的 { $lines } 行脚本。
    }

cloud-setup-not-started = { $device } 的设置脚本未能启动：{ $error }
cloud-setup-gave-up = { $device } 的设置脚本未运行：设备未被打开。请从设备菜单中运行它。
