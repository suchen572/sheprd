settings-save-failed-reloaded = 保存失败；已重新加载当前偏好设置
settings-save-failed = 保存失败；请先重新加载再编辑
settings-saved-daemon-unqueued = 已保存；守护进程重新加载未加入队列：{ $error }
settings-error-save = 保存设置：{ $error }
settings-error-reload = 无法重新加载设置；保留当前偏好设置：{ $error }
settings-error-load-herdr = 加载 Herdr 设置：{ $error }

settings-shared-read-only = Herdr 的设置在此平台上为只读。
settings-shared-unavailable = Herdr 的设置不可用。请重新加载以重试。
